{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-lux.local/schema/sec-03-governance-contract.json",
  "title": "SEC-03 cumulative resolved manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "state", "architecture", "attackMatrix", "predecessor", "sourceManifest", "deltaEntries", "cumulativeEntries", "coverageExemptions", "canonicalPayloadSha256"],
  "properties": {
    "schemaVersion": {"const": 2},
    "task": {"const": "SEC-03"},
    "state": {"const": "governance-ready-runtime-receipts-required"},
    "architecture": {"$ref": "#/$defs/fileBinding"},
    "attackMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactCasePath", "sha256", "realHostFamilyIds", "runtimeReceiptCount"],
      "properties": {
        "exactCasePath": {"const": "tests/sec03-attack-matrix.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "realHostFamilyIds": {"type": "array", "minItems": 19, "maxItems": 19, "uniqueItems": true, "items": {"pattern": "^A(?:0[1-9]|1[0-9])$"}},
        "runtimeReceiptCount": {"const": 482}
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "exactCasePath", "fileSha256", "canonicalPayloadSha256"],
      "properties": {
        "taskId": {"const": "SEC-02"},
        "exactCasePath": {"const": "tests/manifests/sec-02-resolved.json"},
        "fileSha256": {"$ref": "#/$defs/sha256"},
        "canonicalPayloadSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "exactCasePath", "sha256"],
      "properties": {"taskId": {"const": "SEC-03"}, "exactCasePath": {"const": "tests/manifests/sec-03.json"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "deltaEntries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "cumulativeEntries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "coverageExemptions": {"type": "array", "items": {"$ref": "#/$defs/exemption"}},
    "canonicalPayloadSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactCasePath", "sha256"],
      "properties": {"exactCasePath": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "supersedes": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["owner", "sha256", "hashScope"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "hashScope": {"enum": ["file", "predecessor-manifest"]}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactCasePath", "sha256", "kind", "layer", "owner", "testCaseIds", "supersedes"],
      "properties": {
        "exactCasePath": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"enum": ["runtime", "governance", "test"]},
        "layer": {"type": ["string", "null"], "enum": ["unit", "contract", "integration", "electron", "packaged", null]},
        "owner": {"type": "string", "minLength": 1},
        "testCaseIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "supersedes": {"$ref": "#/$defs/supersedes"}
      }
    },
    "evidenceOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptLayer", "testFile", "familyIds"],
      "properties": {
        "receiptLayer": {"const": "real-host"},
        "testFile": {"$ref": "#/$defs/path"},
        "familyIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^A(?:0[1-9]|1[0-9])$"}}
      }
    },
    "exemption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTask", "exactCasePath", "reason", "evidenceLayer", "evidenceOwners"],
      "properties": {
        "sourceTask": {"type": "string", "minLength": 1},
        "exactCasePath": {"$ref": "#/$defs/path"},
        "reason": {"type": "string", "minLength": 12},
        "evidenceLayer": {"enum": ["unit", "contract", "integration", "electron", "packaged"]},
        "evidenceOwners": {"type": "array", "items": {"$ref": "#/$defs/evidenceOwner"}}
      }
    }
  }
}
